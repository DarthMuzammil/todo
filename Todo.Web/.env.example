# Base URL for Todo.Api requests.
# Default (when unset): http://localhost:5167
#
# Local dev with Vite proxy (recommended — avoids CORS):
# VITE_API_BASE_URL=/api
#
# Direct calls to the API (requires CORS on Todo.Api):
VITE_API_BASE_URL=http://localhost:5167

# MVP owner for POST /api/lists until auth exists (FE-306).
# Default when unset: 00000000-0000-0000-0000-000000000001
# VITE_DEV_OWNER_ID=00000000-0000-0000-0000-000000000001
