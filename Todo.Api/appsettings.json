{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/todo.db"
  },
  "Jwt": {
    "Issuer": "Todo.Api",
    "Audience": "Todo.Web",
    "Key": "REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Data": {
    "TasksFile": "data/tasks.json",
    "ListsFile": "data/lists.json",
    "ImportOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}